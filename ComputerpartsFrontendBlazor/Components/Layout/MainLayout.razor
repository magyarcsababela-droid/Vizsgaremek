@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject ComputerpartsFrontendBlazor.Services.AuthService AuthService


@if (ShouldShowNav())
{
    <NavMenu />
}

<main style="min-height: 80vh">
    @Body
</main>
<Footer />
@if (ShouldShowNav())
{
    
}

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }
    protected override async Task OnInitializedAsync()
    {
        // defer JS-dependent auth initialization to after first render
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // call InitializeAsync after first render so browser JS helpers are available
                await AuthService.InitializeAsync();
            }
            catch { }
            StateHasChanged();
        }
    }
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Re-render layout when the URL changes so nav visibility updates
        InvokeAsync(StateHasChanged);
    }

    private bool ShouldShowNav()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrEmpty(relative))
            return true; // home
        var path = relative.Split('?')[0].Trim('/');
        return !string.Equals(path, "login", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(path, "register", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
    private string ShortToken(string? token)
    {
        if (string.IsNullOrEmpty(token)) return "(nincs token)";
        return token.Length > 40 ? token.Substring(0, 20) + "..." + token.Substring(token.Length - 16) : token;
    }

    private async Task CheckAuthAsync()
    {
        if (AuthService != null)
        {
            await AuthService.InitializeAsync();
        }
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        if (AuthService != null)
        {
            await AuthService.LogoutAsync();
        }
        // refresh local state/UI
        await CheckAuthAsync();
        StateHasChanged();
    }
}
