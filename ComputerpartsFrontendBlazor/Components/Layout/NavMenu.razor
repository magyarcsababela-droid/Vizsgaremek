<ProfileModal Show="@showProfile" ShowChanged="EventCallback.Factory.Create<bool>(this, OnProfileShowChanged)" />

@code {
    private bool showProfileDropdown = false;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        // Subscribe to auth state changes so the nav updates when login/logout happens
        try
        {
            AuthService.AuthStateChanged += OnAuthStateChanged;
        }
        catch
        {
            // ignore
        }

        // Ensure service reads localStorage as early as possible so components render correct state
        try
        {
            await AuthService.InitializeAsync();
        }
        catch { }
        StateHasChanged();
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleProfileDropdown()
    {
        showProfileDropdown = !showProfileDropdown;
    }

    private async System.Threading.Tasks.Task OnLogoutClicked()
    {
        if (AuthService != null)
        {
            await AuthService.LogoutAsync();
        }

        Navigation.NavigateTo("/", true);
    }

    // keep OnAfterRender empty — initialization is done in OnInitializedAsync

    public void Dispose()
    {
        try
        {
            AuthService.AuthStateChanged -= OnAuthStateChanged;
        }
        catch { }
    }

    private string ShortToken(string? token)
    {
        if (string.IsNullOrEmpty(token)) return "(nincs token)";
        return token.Length > 40 ? token.Substring(0, 20) + "..." + token.Substring(token.Length - 16) : token;
    }

    private async Task CheckAuthAsync()
    {
        if (AuthService != null)
        {
            await AuthService.InitializeAsync();
        }
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        if (AuthService != null)
        {
            await AuthService.LogoutAsync();
        }
        // refresh local state/UI
        await CheckAuthAsync();
        StateHasChanged();
    }

    private bool showProfile = false;

    private void OpenProfileModal()
    {
        showProfile = true;
    }

    private async Task OnProfileShowChanged(bool val)
    {
        showProfile = val;
        await InvokeAsync(StateHasChanged);
    }

    private void GoToAdmin()
    {
        try
        {
            Navigation.NavigateTo("/admin");
        }
        catch { }
    }
}
