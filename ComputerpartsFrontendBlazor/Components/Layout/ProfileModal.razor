@using Microsoft.AspNetCore.Components
@using System.Linq
@using System.Text.Json
@inject ComputerpartsFrontendBlazor.Services.AuthService AuthService
@inject HttpClient Http
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@rendermode InteractiveServer
@if (Show)
{
    <div class="glassy-backdrop active"></div>
    <div class="modal fade show d-block" id="profileModal" data-bs-backdrop="false" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content" style="color: white; background-color: #181818; box-shadow: 1px 1px 20px black;">
                <div class="modal-header">
                    <h5 class="modal-title">Profil</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <div>
                        <strong>@(string.IsNullOrEmpty(AuthService.Username) ? "(nincs felhasználónév)" : AuthService.Username)</strong>
                        @if (!string.IsNullOrEmpty(AuthService.Email))
                        {
                            <div>@AuthService.Email</div>
                        }

@* confirmation modal is rendered after the profile modal block to avoid stacking context issues *@
                    </div>
                    <hr />
                    <div>
                        <h6>Mentett konfigurációk</h6>
                        @if (isLoading)
                        {
                            <div>Betöltés...</div>
                        }
                        else if (savedBuilds == null || !savedBuilds.Any())
                        {
                            <div>Nincsenek mentett konfigurációk.</div>
                        }
                        else
                        {
                            <ul class="list-group">
                            @foreach (var b in savedBuilds)
                            {
                                    <li style="background-color: #181818; color: white; border: 1px solid dimgray;" class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div><strong>@(string.IsNullOrEmpty(b.name) ? "(névtelen)" : b.name)</strong></div>
                                            <div style="font-size:0.85rem;">@b.created_at.LocalDateTime.ToString("g") - @b.total_price.ToString("C", currencyformat)</div>
                                        </div>
                                        <div class="d-flex flex-column align-items-end">
                                            <button type="button" class="btn btn-sm btn-outline-primary mb-1" @onclick="() => ToggleBuildDetails(b.build_id, b.components_json)">@(expandedBuildId == b.build_id ? "Rejt" : "Megnyit")</button>
                                            <div class="btn-group" role="group">
                                                <button type="button" class="btn btn-sm btn-primary" @onclick="async () => await OpenInConfigurator(b.build_id)">Megnyit a konfigurátorban</button>
                                                <button type="button" class="btn btn-sm btn-danger" @onclick="() => ShowDeleteConfirm(b.build_id)">Törlés</button>
                                            </div>
                                        </div>
                                    </div>
                                    @if (expandedBuildId == b.build_id && selectedComponents != null)
                                    {
                                        <div class="mt-2">
                                            <strong>Alkatrészek:</strong>
                                            <ul class="list-unstyled" style="margin-left:0.5rem;">
                                                @foreach (var c in selectedComponents)
                                                {
                                                    @if ((c.type ?? string.Empty).ToUpperInvariant() == "NOTE")
                                                    {
                                                        <li><em>Megjegyzés:</em> <span>@(c.note ?? "")</span></li>
                                                    }

@* delete confirmation modal is rendered later outside list to avoid nested DOM issues *@
                                                    else
                                                    {
                                                        <li>@(c.type ?? "") - <strong>@(c.name ?? "(név nélkül)")</strong> @if (c.price.HasValue) { <span>(@c.price.Value.ToString("C", currencyformat))</span> }</li>
                                                    }
                                                }
                                            </ul>
                                        </div>
                                    }
                                </li>
                            }
                            </ul>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close">Bezár</button>
                    <button type="button" class="btn btn-danger" @onclick="Logout">Kijelentkezés</button>
                </div>
            </div>
        </div>
    </div>
}
@if (showDeleteConfirm && pendingDeleteId.HasValue)
{
    <div style="position:fixed;inset:0;z-index:2100;">
        <div class="glassy-backdrop" style="position:fixed;inset:0;z-index:2100"></div>
        <div style="position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:2110;min-width:280px;max-width:90%;">
            <div class="modal-content" style="color: white; background-color: #181818; box-shadow: 1px 1px 20px black; border-radius: 8px; padding: 15px;">
                <div class="modal-header">
                    <h5 class="modal-title">Megerősítés</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Biztosan törölni szeretnéd ezt a konfigurációt?</p>
                </div>
                <div class="modal-footer">
                    <button style="margin: 2px" type="button" class="btn btn-secondary" @onclick="CancelDelete">Mégse</button>
                    <button style="margin: 2px" type="button" class="btn btn-primary" @onclick="ConfirmDeleteAsync">Törlés</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool Show { get; set; }

    [Parameter]
    public EventCallback<bool> ShowChanged { get; set; }

    [Parameter]
    public EventCallback<int> OpenBuildRequested { get; set; }

    private bool isLoading = false;
    private List<ComputerpartsLibrary.MODEL.Custom_builds>? savedBuilds;
    private int? expandedBuildId = null;
    private List<ComponentItem>? selectedComponents = null;
    private System.Globalization.CultureInfo currencyformat = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    protected override async Task OnParametersSetAsync()
    {
        if (Show)
        {
            await LoadSavedBuildsAsync();
        }
    }

    private async Task LoadSavedBuildsAsync()
    {
        isLoading = true;
        try
        {
            if (!AuthService.IsAuthenticated)
            {
                savedBuilds = new List<ComputerpartsLibrary.MODEL.Custom_builds>();
                return;
            }

            // ensure token present in AuthService
            if (string.IsNullOrEmpty(AuthService.Token))
            {
                await AuthService.InitializeAsync();
            }

            var uid = AuthService.UserId ?? 0;
            var builds = await AuthService.GetJsonAsync<List<ComputerpartsLibrary.MODEL.Custom_builds>>($"api/custombuilds/user/{uid}");
            savedBuilds = builds ?? new List<ComputerpartsLibrary.MODEL.Custom_builds>();
        }
        catch
        {
            savedBuilds = new List<ComputerpartsLibrary.MODEL.Custom_builds>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        await Close();
        try { await JS.InvokeVoidAsync("setPendingToast", "Kijelentkezés sikeres.", "success", 4000, "bottom-center"); } catch { }
        try { await JS.InvokeVoidAsync("showToast", "Kijelentkezés sikeres.", "success", 4000, "bottom-center"); } catch { }
        // wait a short moment so the user can perceive the toast before full reload
        try { await Task.Delay(600); } catch { }
        Navigation.NavigateTo("/", true);
    }

    private async Task Close()
    {
        Show = false;
        await ShowChanged.InvokeAsync(Show);
    }

    private void OpenBuild(int id)
    {
        // navigate to configurator and pass query param to open that build (consumer can implement)
        Navigation.NavigateTo($"/configurator?buildId={id}");
    }

    private void ToggleBuildDetails(int id, string? componentsJson)
    {
        if (expandedBuildId == id)
        {
            expandedBuildId = null;
            selectedComponents = null;
            return;
        }

        expandedBuildId = id;
        if (string.IsNullOrEmpty(componentsJson))
        {
            selectedComponents = new List<ComponentItem>();
        }
        else
        {
            try
            {
                selectedComponents = JsonSerializer.Deserialize<List<ComponentItem>>(componentsJson) ?? new List<ComponentItem>();
            }
            catch
            {
                selectedComponents = new List<ComponentItem>();
            }
        }
    }

    private async Task OpenInConfigurator(int id)
    {
        // Ask parent to perform the navigation so it can also close the modal in a single flow.
        if (OpenBuildRequested.HasDelegate)
        {
            try
            {
                await OpenBuildRequested.InvokeAsync(id);
                return;
            }
            catch { }
        }

        // fallback: if no parent handler, just navigate
        try
        {
            Navigation.NavigateTo($"/configurator?buildId={id}");
        }
        catch
        {
            try { await JS.InvokeVoidAsync("open", Navigation.ToAbsoluteUri($"/configurator?buildId={id}").ToString(), "_self"); } catch { }
        }
    }

    private class ComponentItem
    {
        public string? type { get; set; }
        public int? id { get; set; }
        public string? name { get; set; }
        public decimal? price { get; set; }
        public string? note { get; set; }
    }

    private async Task DeleteBuildAsync(int id)
    {
        // Shouldn't be called directly anymore; use ConfirmDeleteAsync which is triggered from modal
        await ConfirmDeleteAsync();
    }

    private int? pendingDeleteId = null;
    private bool showDeleteConfirm = false;

    private void ShowDeleteConfirm(int id)
    {
        pendingDeleteId = id;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        pendingDeleteId = null;
        showDeleteConfirm = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (!pendingDeleteId.HasValue) return;
        var id = pendingDeleteId.Value;
        pendingDeleteId = null;
        showDeleteConfirm = false;

        if (!AuthService.IsAuthenticated)
        {
            await JS.InvokeVoidAsync("showToast", "Törléshez előbb jelentkezz be.", "warning", 5000);
            return;
        }

        try
        {
            if (string.IsNullOrEmpty(AuthService.Token)) await AuthService.InitializeAsync();

            var req = new HttpRequestMessage(HttpMethod.Delete, $"api/custombuilds/{id}");
            if (!string.IsNullOrEmpty(AuthService.Token)) req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthService.Token);

            var resp = await Http.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                // refresh list
                await LoadSavedBuildsAsync();
                await JS.InvokeVoidAsync("showToast", "Konfiguráció törölve.", "success", 4000);
            }
            else if (resp.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                await JS.InvokeVoidAsync("showToast", "Nincs jogosultságod törölni ezt a konfigurációt.", "warning", 6000);
            }
            else
            {
                var body = string.Empty;
                try { body = await resp.Content.ReadAsStringAsync(); } catch { }
                await JS.InvokeVoidAsync("showToast", "Törlés sikertelen: " + resp.StatusCode + " - " + body, "danger", 7000);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showToast", "Hiba: " + ex.Message, "danger", 7000);
        }
    }
}
