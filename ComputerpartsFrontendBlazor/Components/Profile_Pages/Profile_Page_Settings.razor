@page "/profile/settings"
@using ComputerpartsFrontendBlazor.Components.Layout
@inherits LayoutComponentBase
@rendermode InteractiveServer

<PageTitle>Beállítások - ComputerParts.com</PageTitle>

<section class="page-header hero-mini">
    <h1>Fiók beállítások</h1>
    <p>Értesítések, adatvédelem és egyéb fiók opciók.</p>
</section>

@* Profile navigation *@
<nav class="profile-nav d-flex gap-2" style="margin-bottom:1rem;">
    <a class="btn btn-secondary" href="/profile">Fiók áttekintés</a>
    <a class="btn btn-secondary" href="/profile/orders">Rendeléseim</a>
    <a class="btn btn-secondary" href="/profile/data">Személyes adatok</a>
    <a class="btn btn-secondary" href="/profile/settings">Beállítások</a>
</nav>

<section class="page-section">
    <div class="detail-card">
        <h3>Értesítések</h3>
        <div style="margin-top:.6rem;">
            <div><input type="checkbox" @bind="newsletter" /> <label>Hírlevél feliratkozás</label></div>
            <div><input type="checkbox" @bind="orderEmails" /> <label>Rendelés státusz értesítések</label></div>
            <div style="margin-top:1rem;"><button class="btn" @onclick="Save">Mentés</button></div>
        </div>
    </div>
</section>

@code {
    private bool newsletter = true;
    private bool orderEmails = true;

    private void Save()
    {
        // demo: persist locally
    }
}
