@page "/profile"
@using ComputerpartsFrontendBlazor.Components.Layout
@inject ComputerpartsFrontendBlazor.Services.AuthService AuthService
@inherits LayoutComponentBase
@rendermode InteractiveServer

<PageTitle>Profile - ComputerParts.com</PageTitle>

<section class="page-header hero-mini">
    <h1>Fiókom</h1>
    <p>Felhasználói adatok, rendelések és fiókbeállítások egy helyen.</p>
</section>

@* Profile navigation *@
<nav class="profile-nav d-flex gap-2" style="margin-bottom:1rem;">
    <a class="btn btn-secondary" href="/profile">Fiók áttekintés</a>
    <a class="btn btn-secondary" href="/profile/orders">Rendeléseim</a>
    <a class="btn btn-secondary" href="/profile/data">Személyes adatok</a>
    <a class="btn btn-secondary" href="/profile/settings">Beállítások</a>
</nav>

<section class="page-section">
    <div class="detail-card profile-overview">
        <h3>Alapadatok</h3>
        <div style="margin-top:.6rem;"><strong>Név:</strong> @(string.IsNullOrEmpty(AuthService?.Username) ? "Vendég" : AuthService.Username)</div>
        <div style="margin-top:.4rem;"><strong>Bejelentkezve:</strong> @(AuthService?.IsAuthenticated == true ? "Igen" : "Nem")</div>
        <div style="margin-top:1rem;"><a class="small-link" href="/profile/data">Adatok szerkesztése</a></div>
    </div>
</section>
