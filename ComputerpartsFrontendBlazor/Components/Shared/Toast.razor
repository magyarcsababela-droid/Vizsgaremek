@using Microsoft.AspNetCore.Components
@if (Visible && !string.IsNullOrEmpty(Message))
{
    <div class="toast-custom toast-@Type" style="@PositionStyle">
        <div class="toast-body">
            <div class="toast-text">@Message</div>
            <button class="toast-close" @onclick="Close">×</button>
        </div>
    </div>
}

@code {
    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string Type { get; set; } = "danger"; // primary, success, warning, danger

    [Parameter]
    /// <summary>
    /// Position can be: "top-right" (default) or "bottom-center".
    /// When set to "bottom-center" the toast will render centered at the bottom of the viewport.
    /// </summary>
    public string Position { get; set; } = "top-right";

    [Parameter]
    public bool AutoHide { get; set; } = true;

    [Parameter]
    public int Duration { get; set; } = 5000; // ms

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool Visible { get; set; } = true;

    private string? PositionStyle => string.Equals(Position, "bottom-center", StringComparison.OrdinalIgnoreCase)
        ? "right: auto; left: 50%; transform: translateX(-50%); top: auto; bottom: 1rem;"
        : null;

    protected override void OnParametersSet()
    {
        Visible = !string.IsNullOrEmpty(Message);
        if (Visible && AutoHide)
        {
            _ = AutoHideTask();
        }
    }

    private async Task AutoHideTask()
    {
        try
        {
            await Task.Delay(Duration);
            await Close();
        }
        catch { }
    }

    private async Task Close()
    {
        Visible = false;
        await OnClose.InvokeAsync(null);
        StateHasChanged();
    }
}
