@page "/login"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<main class="auth-wrap">
    <section class="login-card page-anim">
        <h2>Bejelentkezés</h2>
        <p class="muted" style="margin-bottom:1rem;">Hozzáférés a fiókodhoz a rendeléseket, mentett épített gépeket, és segítség kéréseket.</p>
        <div class="form-grid">
            <div class="full">
                <label for="loginEmail">Email vagy Felhasználónév</label>
                <input id="loginEmail" @bind="Model.UsernameOrEmail" type="text" placeholder="you@example.com vagy Felhasználónév" />
            </div>
            <div class="full">
                <label for="loginPassword">Jelszó</label>
                <input id="loginPassword" @bind="Model.Password" type="password" placeholder="••••••••" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn" @onclick="LoginAsync" disabled="@(IsSubmitting)">
                @(IsSubmitting ? "Signing in..." : "Login")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <p class="muted">@StatusMessage</p>
        }

        <p class="switch-link">Nincs még fiókod? <a href="register">Készíts egyet itt...</a>.</p>
        <p class="switch-link">Vissza a kezőlapra <a href="/">Kezdőlap</a></p>
    </section>
</main>


@code {
    private LoginFormModel Model { get; set; } = new();
    private bool IsSubmitting { get; set; }
    private string? StatusMessage { get; set; }

    private class LoginFormModel
    {
        public string UsernameOrEmail { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private async Task LoginAsync()
    {
        StatusMessage = null;

        if (string.IsNullOrWhiteSpace(Model.UsernameOrEmail))
        {
            StatusMessage = "Please enter your username or email.";
            return;
        }

        if (string.IsNullOrEmpty(Model.Password))
        {
            StatusMessage = "Please enter your password.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var payload = new
            {
                Username = Model.UsernameOrEmail,
                Password = Model.Password
            };

            var response = await Http.PostAsJsonAsync("api/auth/login", payload);

            if (response.IsSuccessStatusCode)
            {
                // Optionally read returned user info
                StatusMessage = "Login successful. Redirecting...";
                await Task.Delay(500);
                Navigation.NavigateTo("/");
            }
            else
            {
                try
                {
                    var err = await response.Content.ReadFromJsonAsync<ServerError?>();
                    StatusMessage = err?.message ?? "Login failed. Check credentials.";
                }
                catch
                {
                    StatusMessage = "Login failed. Check credentials.";
                }
            }
        }
        catch (Exception ex)
        {
            StatusMessage = "An error occurred: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private class ServerError
    {
        public string? message { get; set; }
    }
}
