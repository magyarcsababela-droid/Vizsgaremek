@page "/login"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject ComputerpartsFrontendBlazor.Services.AuthService AuthService
@inject NavigationManager Navigation

<main class="auth-wrap">
    <section class="login-card page-anim">
        <h2>Bejelentkezés</h2>
        <p class="muted" style="margin-bottom:1rem;">Hozzáférés a fiókodhoz a rendeléseket, mentett épített gépeket, és segítség kéréseket.</p>
        <div class="form-grid">
            <div class="full">
                <label for="loginEmail">Email vagy Felhasználónév</label>
                <input id="loginEmail" @bind="Model.UsernameOrEmail" type="text" placeholder="Felhasználnév" />
            </div>
            <div class="full">
                <label for="loginPassword">Jelszó</label>
                <input id="loginPassword" @bind="Model.Password" type="password" placeholder="Jelszó" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn" @onclick="LoginAsync" disabled="@(IsSubmitting)">
                @(IsSubmitting ? "Bejelentkezés..." : "Bejelentkezés")
            </button>
        </div>



        <p class="switch-link">Nincs még fiókod? <a href="register">Készíts egyet itt...</a>.</p>
        <p class="switch-link">Vissza a kezőlapra <a href="/">Kezdőlap</a></p>
    </section>
</main>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <Toast Message="@StatusMessage" Type="warning" Position="bottom-center" AutoHide="true" Duration="5000" />
}


@code {
    private LoginFormModel Model { get; set; } = new();
    private bool IsSubmitting { get; set; }
    private string? StatusMessage { get; set; }

    private class LoginFormModel
    {
        public string UsernameOrEmail { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private async Task LoginAsync()
    {
        StatusMessage = null;

        if (string.IsNullOrWhiteSpace(Model.UsernameOrEmail))
        {
            StatusMessage = "Please enter your username or email.";
            return;
        }

        if (string.IsNullOrEmpty(Model.Password))
        {
            StatusMessage = "Please enter your password.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var success = await AuthService.LoginAsync(Model.UsernameOrEmail, Model.Password);

            if (success)
            {
                StatusMessage = "Sikeres bejelentkezés. Átirányítás...";
                await Task.Delay(400);
                // force reload so other components pick up persisted token
                Navigation.NavigateTo("/", true);
            }
            else
            {
                StatusMessage = "Bejelentkezés sikertelen. Ellenőrizd a hitelesítő adatokat.";
            }
        }
        catch (Exception ex)
        {
            StatusMessage = "Hiba történt: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private class ServerError
    {
        public string? message { get; set; }
    }
}