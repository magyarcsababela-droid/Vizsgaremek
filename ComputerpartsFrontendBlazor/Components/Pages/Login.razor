@page "/login"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject ComputerpartsFrontendBlazor.Services.AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.AspNetCore.WebUtilities

<main class="auth-wrap">
    <section class="login-card page-anim">
        <h2>Bejelentkezés</h2>
        <p class="muted" style="margin-bottom:1rem;">Hozzáférés a fiókodhoz a rendeléseket, mentett épített gépeket, és segítség kéréseket.</p>
        <div class="form-grid">
            <div class="full">
                <label for="loginEmail">Email vagy Felhasználónév</label>
                <input id="loginEmail" @bind="Model.UsernameOrEmail" type="text" placeholder="Felhasználnév" />
            </div>
            <div class="full">
                <label for="loginPassword">Jelszó</label>
                <input id="loginPassword" @bind="Model.Password" type="password" placeholder="Jelszó" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn" style="width: 100%" @onclick="LoginAsync" disabled="@(IsSubmitting)">
                @(IsSubmitting ? "Bejelentkezés..." : "Bejelentkezés")
            </button>
        </div>



        <p class="switch-link">Nincs még fiókod? <a href="register">Készíts egyet itt...</a>.</p>
        <p class="switch-link">Vissza a kezőlapra <a href="/">Kezdőlap</a></p>
    </section>
</main>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <Toast Message="@StatusMessage" Type="warning" Position="bottom-center" AutoHide="true" Duration="5000" />
}


@code {
    private LoginFormModel Model { get; set; } = new();
    private bool IsSubmitting { get; set; }
    private string? StatusMessage { get; set; }

    private class LoginFormModel
    {
        public string UsernameOrEmail { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private async Task LoginAsync()
    {
        StatusMessage = null;

        // determine returnUrl: prefer explicit query param, fall back to document.referrer
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var qs = QueryHelpers.ParseQuery(uri.Query);
        string? returnUrl = null;
        if (qs.TryGetValue("returnUrl", out var vals))
        {
            returnUrl = vals.FirstOrDefault();
        }
        if (string.IsNullOrEmpty(returnUrl))
        {
            try
            {
                var referrer = await JS.InvokeAsync<string>("eval", "document.referrer");
                if (!string.IsNullOrEmpty(referrer))
                {
                    // only use referrer if it's same origin
                    var baseUri = Navigation.BaseUri;
                    if (referrer.StartsWith(baseUri, StringComparison.OrdinalIgnoreCase))
                    {
                        var rel = Navigation.ToBaseRelativePath(referrer);
                        returnUrl = "/" + rel.TrimStart('/');
                    }
                }
            }
            catch { }
        }

        if (string.IsNullOrWhiteSpace(Model.UsernameOrEmail))
        {
            StatusMessage = "Kérlek add meg a felhasználóneved.";
            return;
        }

        if (string.IsNullOrEmpty(Model.Password))
        {
            StatusMessage = "Kérlek add meg a jelszavad.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var success = await AuthService.LoginAsync(Model.UsernameOrEmail, Model.Password);

            if (success)
            {
                StatusMessage = "Sikeres bejelentkezés. Átirányítás...";
                await Task.Delay(400);
                // navigate back to returnUrl if valid local path
                if (!string.IsNullOrEmpty(returnUrl))
                {
                    try
                    {
                        // prevent open redirect: only allow absolute same-origin or relative paths
                        if (Uri.TryCreate(returnUrl, UriKind.Absolute, out var abs) )
                        {
                            var baseUri = new Uri(Navigation.BaseUri);
                            if (abs.Scheme == baseUri.Scheme && abs.Host == baseUri.Host && abs.Port == baseUri.Port)
                            {
                                Navigation.NavigateTo(abs.PathAndQuery, true);
                                return;
                            }
                        }
                        else if (returnUrl.StartsWith("/"))
                        {
                            Navigation.NavigateTo(returnUrl, true);
                            return;
                        }
                    }
                    catch { }

                }
                Navigation.NavigateTo("/", true);
            }
            else
            {
                StatusMessage = "Bejelentkezés sikertelen. Kérlek próbáld újra.";
            }
        }
        catch (Exception ex)
        {
            StatusMessage = "Hiba történt: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private class ServerError
    {
        public string? message { get; set; }
    }
}