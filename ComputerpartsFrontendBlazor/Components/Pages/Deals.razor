@page "/deals"
@rendermode InteractiveServer
@using ComputerpartsFrontendBlazor.Components.Layout
@inherits LayoutComponentBase
@inject HttpClient Http

<main style="min-height: 75vh;">
    <section class="page-header_custom page-header hero-mini">
        <h1>Ajánlatok & Promóciók</h1>
        <p>Jelenlegi kampányaink, limitált leárazásaink és csomag ajánlataink kiemelve, amik elérhetőek áruházunkon.</p>
    </section>
    <section class="page-section">
        @if (isLoading)
        {
            <div>Betöltés...</div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }
        else if (deals == null || deals.Count == 0)
        {
            <p>Nincsenek ajánlatok jelenleg.</p>
        }
        else
        {
            <div class="deal-grid">
                @foreach (var d in deals)
                {
                    <div class="deal-card">
                        <span class="deal-tag">Ajánlat</span>
                        <h3>@d.name</h3>
                        @if (!string.IsNullOrEmpty(d.description))
                        {
                            <p class="muted">@d.description</p>
                        }
                        <p class="price" style="margin:1rem 0;">@d.price.ToString("C", currencyformat)</p>
                        <button class="btn">Részletek</button>
                    </div>
                }
            </div>
        }
    </section>
</main>

@code {
    private List<ComputerpartsLibrary.MODEL.Deals>? deals;
    private bool isLoading = false;
    private string? errorMessage;
    private System.Globalization.CultureInfo currencyformat = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var all = await Http.GetFromJsonAsync<List<ComputerpartsLibrary.MODEL.Deals>>("api/deals");
            if (all == null)
            {
                errorMessage = "Nem sikerült lekérni az ajánlatokat.";
                deals = new List<ComputerpartsLibrary.MODEL.Deals>();
            }
            else
            {
                deals = all;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hiba történt: {ex.Message}";
            deals = new List<ComputerpartsLibrary.MODEL.Deals>();
        }
        isLoading = false;
        StateHasChanged();
    }
}
