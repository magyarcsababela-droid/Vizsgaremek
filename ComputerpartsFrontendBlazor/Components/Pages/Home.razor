@page "/"
@using ComputerpartsFrontendBlazor.Components.Layout
@inherits LayoutComponentBase
<PageTitle>ComputerParts.com</PageTitle>
<!-- Hero -->
<section class="hero">
    <div class="hero-content">
        <h1>Építsd meg az álom PC-d</h1>
        <p>Válassz több ezer alkatrész közül és hozd létre a legbrutálabb gépet játékra, munkára vagy kreativitásra!</p>
        <button class="btn"><a href="/configurator">Konfigurálás megkezdése</a></button>
    </div>
</section>

<!-- Popular categories -->
<section class="configurator-section">
    <h2>Népszerű alkatrész kategóriák</h2>
    <div class="config-grid">
        <div class="config-card">
            <h3>CPU</h3>
            <p>Intel vagy AMD processzorok – válaszd a Számodra megfelelő magot a munkádhoz!</p>
            <button class="btn">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>GPU</h3>
            <p>Nagy teljesítményű grafikus kártyák gaming-re és munkára.</p>
            <button class="btn">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>RAM</h3>
            <p>8 -128 GB DDR4/DDR5 – válaszd ki igényeidnek megfelelő típust.</p>
            <button class="btn">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>Storage</h3>
            <p>Gyors NVMe SSD-k és nagy kapacitású HDD-k minden adatod szükségletéhez.</p>
            <button class="btn">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>Case</h3>
            <p>Menő dizájnok jó légáramlattal, edzett üveggel vagy minimalista stílusok.</p>
            <button class="btn">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>PSU</h3>
            <p>Megbízható tápegységek - 80+ Gold és Platinum hatásfokkal, 300W-tól akár 2000W-ig.</p>
            <button class="btn">Opciók megtekintése</button>
        </div>
    </div>
</section>

<!-- Featured products -->
<section class="section-title">Kiemelt Termékek</section>
<div class="product-grid">
    <div class="product-card">
        <img src="https://via.placeholder.com/300x200?text=Intel+Core+i7" alt="Intel Core i7">
        <h3 class="product-name">Intel Core i7‑13700K</h3>
        <p class="product-price">$499.99</p>
        <div class="product-rating">★★★★★</div>
        <p class="product-description">13th Gen Intel Core i7 with 14 cores & 20 threads.</p>
        <div class="product-actions">
            <button class="btn-primary">Hozzáadás Kosárhoz</button>
        </div>
    </div>

    <div class="product-card">
        <img src="https://via.placeholder.com/300x200?text=NVIDIA+RTX+4080" alt="NVIDIA RTX 4080">
        <h3 class="product-name">NVIDIA GeForce RTX 4080</h3>
        <p class="product-price">$1,499.99</p>
        <div class="product-rating">★★★★★</div>
        <p class="product-description">16 GB GDDR6X, 1000 MHz boost clock.</p>
        <div class="product-actions">
            <button class="btn-primary">Hozzáadás Kosárhoz</button>
        </div>
    </div>

    <div class="product-card">
        <img src="https://via.placeholder.com/300x200?text=Kingston+DDR5+64GB" alt="Kingston DDR5 64GB">
        <h3 class="product-name">Kingston DDR5 64 GB (2×32 GB)</h3>
        <p class="product-price">$299.99</p>
        <div class="product-rating">★★★★★</div>
        <p class="product-description">DDR5 5600 MHz, CL30, dual‑channel.</p>
        <div class="product-actions">
            <button class="btn-primary">Hozzáadás Kosárhoz</button>
        </div>
    </div>

    <div class="product-card">
        <img src="https://via.placeholder.com/300x200?text=Samsung+980+Pro" alt="Samsung 980 Pro">
        <h3 class="product-name">Samsung 980 Pro 2TB NVMe SSD</h3>
        <p class="product-price">$249.99</p>
        <div class="product-rating">★★★★★</div>
        <p class="product-description">PCIe 4.0, 7,450 MB/s read speed.</p>
        <div class="product-actions">
            <button class="btn-primary">Hozzáadás Kosárhoz</button>
        </div>
    </div>
</div>
<footer class="footer">
    <div class="footer-links">
        <a href="Parts.razor">Alkatrészek</a>
        <a href="Support.razor">Támogatás</a>
        <a href="Deals.razor">Ajánlatok</a>
        <a href="Contact.razor">Kapcsolat</a>
        <a href="Login.razor">Bejelentkezés</a>
    </div>
    <p>© 2026 ComputerParts.com. All rights reserved//Minden jog fenntartva.</p>
</footer>