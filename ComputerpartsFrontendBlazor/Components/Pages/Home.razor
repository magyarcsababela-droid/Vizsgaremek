<!-- Népszerű kategóriák -->
<section class="configurator-section">
    <h2>Népszerű alkatrész kategóriák</h2>
    <div class="config-grid">
        <div class="config-card">
            <h3>Alaplap</h3>
            <p>A számítógép alap alkotó eleme - válassz okosan, mert ettől függhetnek más alkatrészek.</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(8)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>CPU</h3>
            <p>Intel vagy AMD processzorok – válaszd a Számodra megfelelő magot a munkádhoz!</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(1)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>GPU</h3>
            <p>Nagy teljesítményű grafikus kártyák egyaránt gaming-re és munkára szánva.</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(2)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>RAM</h3>
            <p>8 -128 GB DDR4/DDR5 – válaszd ki igényeidnek megfelelő típust.</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(3)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>Tárhely</h3>
            <p>Gyors NVMe SSD-k és nagy kapacitású HDD-k minden adatod szükségletéhez.</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(4)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>Hűtés</h3>
            <p>A processzor hűtésének megoldásai - léghűtő vagy vízhűtő</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(5)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>Gépház</h3>
            <p>Menő dizájnok jó légáramlattal, edzett üveggel vagy minimalista stílusok.</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(6)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>Tápegység</h3>
            <p>Megbízható tápegységek - 80+ Gold és Platinum hatásfokkal, 300W-tól akár 2000W-ig.</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(7)">Opciók megtekintése</button>
        </div>
    </div>
</section>

@if (showBackdrop)
{
    <div class="glassy-backdrop" @onclick="CloseModal"></div>
}

@* Modal a az adott kategória alkatrészeinek listázására *@
<div class="modal fade" id="componentsModal" data-bs-backdrop="false" tabindex="-1" aria-labelledby="componentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" style="color: white; background-color: #181818; box-shadow: 1px 1px 20px black;">
            <div class="modal-header">
                <h5 class="modal-title" id="componentsModalLabel">Elérhető alkatrészek</h5>
                
            </div>
            <div class="modal-body">
                @if (isLoading)
                {
                    <div>Betöltés...</div>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                else if (filteredComponents == null || filteredComponents.Count == 0)
                {
                    <p>Nincs találat ebben a kategóriában.</p>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var comp in filteredComponents)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start" style="background-color: rgba(0, 0, 0, 0.1); color: white;">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold">@comp.name</div>
                                    @comp.description
                                </div>
                                <span class="badge bg-primary rounded-pill">@comp.price.ToString("C", currencyformat)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @onclick="CloseModal">Bezár</button>
            </div>
        </div>
    </div>
</div>

<!-- Kiemelt Termékek -->
<section class="section-title">Kiemelt Termékek</section>
<div class="product-grid">
    @if (filteredproducts == null || filteredproducts.Count == 0)
    {
        <p>No products yet.</p>
    }
    else
    {
        @foreach (var product in filteredproducts)
        {
            <div class="product-card">
                <div>
                    @* <img src="https://via.placeholder.com/300x200?text=Intel+Core+i7" alt="Intel Core i7"> *@
                    <h3 class="product-name">@product.name</h3>
                    <p class="product-price">@product.base_price.ToString("C", currencyformat)</p>
                    <p class="product-description">@product.description</p>
                </div>
                <div class="product-actions">
                    <button class="btn-primary" @onclick="OpenAddToCartModal">Hozzáadás Kosárhoz</button>
                </div>
            </div>
        }
    }
</div>
@if (showBackdrop)
{
    <div class="glassy-backdrop" @onclick="CloseModal"></div>
}
<!-- MODAL - "Fejlesztés alatt" -->
@if (isAddToCartModalOpen)
{
    <div class="modal fade" id="developementModal" data-bs-backdrop="false" tabindex="-1" aria-labelledby="developementModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
            <div class="modal-content" style="color: white; background-color: #181818; box-shadow: 1px 1px 20px black;">
                <div class="modal-header">
                    <h5 class="modal-title" id="developementModalLabel">Funkció fejlesztés alatt(WIP) - Hozzáadás kosárhoz</h5>
                </div>
                <div class="modal-body">Mivel a weboldal, folyamatos fejlesztés alatt áll, ez a funkció a késsöbbiekben, lesz hozzáadva.</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @onclick="CloseModal">Bezár</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Components>? filteredComponents;
    private List<Products>? filteredproducts;
    private bool isLoading = false;
    private string? errorMessage;
    private bool testClicked = false;
    private bool showBackdrop = false;
    private System.Globalization.CultureInfo currencyformat = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();
        try
        {
            var all = await Http.GetFromJsonAsync<List<Products>>("api/products");
            if (all == null)
            {
                errorMessage = "Nem sikerült lekérni az adatokat.";
                filteredproducts = new List<Products>();
            }
            else
            {
                filteredproducts = all;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hiba történt: {ex.Message}";
            filteredproducts = new List<Products>();
        }
        isLoading = false;
        StateHasChanged();
    }

    private async Task DebugAndLoad(int typeId)
    {
        // Azonnali visszajelzés a gomb megnyomására, hogy lássuk a reakciót
        errorMessage = $"Gomb megnyomva: {typeId}";
        isLoading = true;
        StateHasChanged();
        // a böngésző konzoljában is megjelenik a log, hogy lássuk a gombkattintást és a típus azonosítóját
        try { await JS.InvokeVoidAsync("console.log", $"Button clicked for type {typeId}"); } catch { }
        await LoadComponentsByType(typeId);
        // jelenleg a modal megjelenítése után töltjük be az adatokat
        showBackdrop = true;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("showModal", "componentsModal"); } catch { }
    }

    private async Task LoadComponentsByType(int typeId)
    {
        isLoading = true;
        errorMessage = null;
        filteredComponents = null;
        StateHasChanged();
        try
        {
            var all = await Http.GetFromJsonAsync<List<Components>>("api/components");
            if (all == null)
            {
                errorMessage = "Nem sikerült lekérni az adatokat.";
                filteredComponents = new List<Components>();
            }
            else
            {
                filteredComponents = all.Where(x => x.type_id == typeId).ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hiba történt: {ex.Message}";
            filteredComponents = new List<Components>();
        }
        isLoading = false;
        StateHasChanged();
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private void ToggleTest()
    {
        testClicked = !testClicked;
    }

    private async Task CloseModal()
    {
        try { await JS.InvokeVoidAsync("hideModal", "componentsModal"); } catch { }
        showBackdrop = false;
        StateHasChanged();
    }
    /* Authentikáció tesztelés logika*/
