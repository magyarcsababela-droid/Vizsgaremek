    //         await AuthService.InitializeAsync();
    //     }
    //     StateHasChanged();
    // }

    // private async Task LogoutAsync()
    // {
    //     if (AuthService != null)
    //     {
    //         await AuthService.LogoutAsync();
    //     }
    //     // refresh local state/UI
    //     await CheckAuthAsync();
    //     StateHasChanged();
    // }

    // Modal state - "Fejlesztés alatt" confirmation
    private bool isAddToCartModalOpen = true;
    private bool isScrollLocked = false;
    /// <summary>
    /// Nyissa meg a modal-t amikor rányomunk "Hozzáadás Kosárhoz" gombra
    /// </summary>
    private void OpenAddToCartModal()
    {
        isAddToCartModalOpen = true;
        try { JS.InvokeVoidAsync("showModal", "developementModal"); } catch { }
        showBackdrop = true;
        isScrollLocked = true; // Lock scroll immediately
        StateHasChanged(); // Reactive update - modal opens immediately
    }

    /// <summary>
    /// Zárja be a modal-t
    /// </summary>
    private void CloseAddToCartModal()
    {
        isAddToCartModalOpen = false;
        showBackdrop = false;
        isScrollLocked = false;
        StateHasChanged();
    }
}
