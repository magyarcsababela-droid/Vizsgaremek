@page "/"
@using ComputerpartsFrontendBlazor.Components.Layout
@using ComputerpartsLibrary.MODEL
@using System.Net.Http.Json
@inject HttpClient Http
@inherits LayoutComponentBase
@rendermode InteractiveServer
<PageTitle>ComputerParts.com</PageTitle>
<!-- Hero -->
<section class="hero">
    <div class="hero-content">
        <h1>Építsd meg az álom PC-d</h1>
        <p>Válassz több ezer alkatrész közül és hozd létre a legbrutálabb gépet játékra, munkára vagy kreativitásra!</p>
        <button class="btn"><a href="/configurator">Konfigurálás megkezdése</a></button>
    </div>
</section>

<!-- Popular categories -->
<section class="configurator-section">
    <h2>Népszerű alkatrész kategóriák</h2>
    <div class="config-grid">
        <div class="config-card">
            <h3>CPU</h3>
            <p>Intel vagy AMD processzorok – válaszd a Számodra megfelelő magot a munkádhoz!</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(1)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>GPU</h3>
            <p>Nagy teljesítményű grafikus kártyák egyaránt gaming-re és munkára szánva.</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(2)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>RAM</h3>
            <p>8 -128 GB DDR4/DDR5 – válaszd ki igényeidnek megfelelő típust.</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(3)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>Tárhely</h3>
            <p>Gyors NVMe SSD-k és nagy kapacitású HDD-k minden adatod szükségletéhez.</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(4)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>Hűtés</h3>
            <p>A processzor hűtésének megoldásai - léghűtő vagy vízhűtő</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(5)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>Gépház</h3>
            <p>Menő dizájnok jó légáramlattal, edzett üveggel vagy minimalista stílusok.</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(6)">Opciók megtekintése</button>
        </div>
        <div class="config-card">
            <h3>Tápegység</h3>
            <p>Megbízható tápegységek - 80+ Gold és Platinum hatásfokkal, 300W-tól akár 2000W-ig.</p>
            <button type="button" class="btn" @onclick="() => DebugAndLoad(7)">Opciók megtekintése</button>
        </div>
    </div>
</section>

@if (showBackdrop)
{
    <div class="glassy-backdrop" @onclick="CloseModal"></div>
}

@* Modal for showing filtered components (Bootstrap backdrop disabled because we render a custom one) *@
<div class="modal fade" id="componentsModal" data-bs-backdrop="false" tabindex="-1" aria-labelledby="componentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content" style="color: white; background-color: #181818; box-shadow: 1px 1px 20px black;">
            <div class="modal-header">
                <h5 class="modal-title" id="componentsModalLabel">Elérhető alkatrészek</h5>
                @* <button type="button" class="btn-close" style="border: 1px solid white;" data-bs-dismiss="modal" aria-label="Close" @onclick="CloseModal"></button> *@
            </div>
            <div class="modal-body">
                @if (isLoading)
                {
                    <div>Betöltés...</div>
                }
                else if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                else if (filteredComponents == null || filteredComponents.Count == 0)
                {
                    <p>Nincs találat ebben a kategóriában.</p>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var comp in filteredComponents)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start" style="background-color: rgba(0, 0, 0, 0.1); color: white;">
                                <div class="ms-2 me-auto">
                                    <div class="fw-bold">@comp.name</div>
                                    @comp.description
                                </div>
                                <span class="badge bg-primary rounded-pill">@comp.price.ToString("C")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @onclick="CloseModal">Bezár</button>
            </div>
        </div>
    </div>
</div>

<!-- Featured products -->
<section class="section-title">Kiemelt Termékek</section>
<div class="product-grid">
    @if (filteredproducts == null || filteredproducts.Count == 0)
