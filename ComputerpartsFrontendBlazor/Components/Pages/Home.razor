@code {
    private List<Components>? filteredComponents;
    private List<Products>? filteredproducts;
    private bool isLoading = false;
    private string? errorMessage;
    private bool testClicked = false;
    private bool showBackdrop = false;

    protected override async System.Threading.Tasks.Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();
        try
        {
            var all = await Http.GetFromJsonAsync<List<Products>>("api/products");
            if (all == null)
            {
                errorMessage = "Nem sikerült lekérni az adatokat.";
                filteredproducts = new List<Products>();
            }
            else
            {
                filteredproducts = all;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hiba történt: {ex.Message}";
            filteredproducts = new List<Products>();
        }
        isLoading = false;
        StateHasChanged();
    }

    private async Task DebugAndLoad(int typeId)
    {
        // immediate visible feedback for debugging
        errorMessage = $"Gomb megnyomva: {typeId}";
        isLoading = true;
        StateHasChanged();
        // also log to browser console
        try { await JS.InvokeVoidAsync("console.log", $"Button clicked for type {typeId}"); } catch { }
        await LoadComponentsByType(typeId);
        // show modal after loading
        showBackdrop = true;
        StateHasChanged();
        try { await JS.InvokeVoidAsync("showModal", "componentsModal"); } catch { }
    }

    private async Task LoadComponentsByType(int typeId)
    {
        isLoading = true;
        errorMessage = null;
        filteredComponents = null;
        StateHasChanged();
        try
        {
            var all = await Http.GetFromJsonAsync<List<Components>>("api/components");
            if (all == null)
            {
                errorMessage = "Nem sikerült lekérni az adatokat.";
                filteredComponents = new List<Components>();
            }
            else
            {
                filteredComponents = all.Where(x => x.type_id == typeId).ToList();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Hiba történt: {ex.Message}";
            filteredComponents = new List<Components>();
        }
        isLoading = false;
        StateHasChanged();
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private void ToggleTest()
    {
        testClicked = !testClicked;
    }

    private async Task CloseModal()
    {
        try { await JS.InvokeVoidAsync("hideModal", "componentsModal"); } catch { }
        showBackdrop = false;
        StateHasChanged();
    }
}
