@page "/"
@using ComputerpartsFrontendBlazor.Components.Layout
@inherits LayoutComponentBase
<PageTitle>ComputerParts.com</PageTitle>
<!-- Hero -->
<section class="hero">
    <div class="hero-content">
        <h1>Build Your Dream PC</h1>
        <p>Select from thousands of components and create the ultimate machine for gaming, work or creativity.</p>
        <button class="btn">Start Configuring</button>
    </div>
</section>

<!-- Popular categories -->
<section class="configurator-section">
    <h2>Popular Component Categories</h2>
    <div class="config-grid">
        <div class="config-card">
            <h3>CPU</h3>
            <p>Intel or AMD processors – choose the right core count for your workload.</p>
            <button class="btn">View Options</button>
        </div>
        <div class="config-card">
            <h3>GPU</h3>
            <p>High‑performance graphics cards for gaming and rendering.</p>
            <button class="btn">View Options</button>
        </div>
        <div class="config-card">
            <h3>RAM</h3>
            <p>8 GB to 128 GB DDR4/DDR5 – pick the speed that fits your tasks.</p>
            <button class="btn">View Options</button>
        </div>
        <div class="config-card">
            <h3>Storage</h3>
            <p>Fast NVMe SSDs and large HDDs for all your data needs.</p>
            <button class="btn">View Options</button>
        </div>
        <div class="config-card">
            <h3>Case</h3>
            <p>Sleek designs with airflow, tempered glass or minimalist styles.</p>
            <button class="btn">View Options</button>
        </div>
        <div class="config-card">
            <h3>Cooling</h3>
            <p>Types of cooling parts</p>
            <button class="btn">View Options</button>
        </div>
        <div class="config-card">
            <h3>PSU</h3>
            <p>Reliable power supplies – 80+ Gold to Platinum efficiency.</p>
            <button class="btn">View Options</button>
        </div>
    </div>
</section>

<!-- Featured products -->
<section class="section-title">Featured Products</section>
<div class="product-grid">
    <div class="product-card">
        <img src="https://via.placeholder.com/300x200?text=Intel+Core+i7" alt="Intel Core i7">
        <h3 class="product-name">Intel Core i7‑13700K</h3>
        <p class="product-price">$499.99</p>
        <div class="product-rating">★★★★★</div>
        <p class="product-description">13th Gen Intel Core i7 with 14 cores & 20 threads.</p>
        <div class="product-actions">
            <button class="btn-primary">Add to Cart</button>
            <button class="btn-secondary">Compare</button>
        </div>
    </div>

    <div class="product-card">
        <img src="https://via.placeholder.com/300x200?text=NVIDIA+RTX+4080" alt="NVIDIA RTX 4080">
        <h3 class="product-name">NVIDIA GeForce RTX 4080</h3>
        <p class="product-price">$1,499.99</p>
        <div class="product-rating">★★★★★</div>
        <p class="product-description">16 GB GDDR6X, 1000 MHz boost clock.</p>
        <div class="product-actions">
            <button class="btn-primary">Add to Cart</button>
            <button class="btn-secondary">Compare</button>
        </div>
    </div>

    <div class="product-card">
        <img src="https://via.placeholder.com/300x200?text=Kingston+DDR5+64GB" alt="Kingston DDR5 64GB">
        <h3 class="product-name">Kingston DDR5 64 GB (2×32 GB)</h3>
        <p class="product-price">$299.99</p>
        <div class="product-rating">★★★★★</div>
        <p class="product-description">DDR5 5600 MHz, CL30, dual‑channel.</p>
        <div class="product-actions">
            <button class="btn-primary">Add to Cart</button>
            <button class="btn-secondary">Compare</button>
        </div>
    </div>

    <div class="product-card">
        <img src="https://via.placeholder.com/300x200?text=Samsung+980+Pro" alt="Samsung 980 Pro">
        <h3 class="product-name">Samsung 980 Pro 2TB NVMe SSD</h3>
        <p class="product-price">$249.99</p>
        <div class="product-rating">★★★★★</div>
        <p class="product-description">PCIe 4.0, 7,450 MB/s read speed.</p>
        <div class="product-actions">
            <button class="btn-primary">Add to Cart</button>
            <button class="btn-secondary">Compare</button>
        </div>
    </div>
</div>
<footer class="footer">
    <div class="footer-links">
        <a href="parts.html">Parts</a>
        <a href="support.html">Support</a>
        <a href="deals.html">Deals</a>
        <a href="contact.html">Contact</a>
        <a href="login.html">Login</a>
    </div>
    <p>© 2026 ComputerParts.com. All rights reserved.</p>
</footer>