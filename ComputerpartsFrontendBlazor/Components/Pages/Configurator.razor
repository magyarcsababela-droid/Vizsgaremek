@page "/configurator"
@using ComputerpartsFrontendBlazor.Components.Layout
@using ComputerpartsLibrary.MODEL
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject ComputerpartsFrontendBlazor.Services.AuthService AuthService
@inject Microsoft.AspNetCore.Components.NavigationManager Navigation
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.WebUtilities
@using System.Net.Http.Headers
@inherits LayoutComponentBase
@rendermode InteractiveServer
<main style="min-height: 75vh;">
    <section class="page-header_custom page-header hero-mini">
        <h1>PC Konfigurátor</h1>
        <p>Rakjon össze egy kiegyensújozott PC-t, az elérhető fő komponensekből és a jobb oldali panelen ellenőrizve választásait.</p>
    </section>
    <section class="page-section configurator-layout">
        <div class="detail-card">
            <h3>Válaszd ki a megfelelő alkatrészeket</h3>
            <div class="form-grid">
                <div>
                    <label for="cpu">CPU</label>
                    <select id="cpu" @bind="SelectedCpuId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(1, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C", currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="motherboard">Alaplap</label>
                    <select id="motherboard" @bind="SelectedMotherboardId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(8, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C", currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="gpu">GPU</label>
                    <select id="gpu" @bind="SelectedGpuId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(2, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C", currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="ram">Memória</label>
                    <select id="ram" @bind="SelectedRamId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(3, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C", currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="storage">Tárkapacitás</label>
                    <select id="storage" @bind="SelectedStorageId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(4, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C",currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="cooler">CPU hűtő</label>
                    <select id="cooler" @bind="SelectedCoolerId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(5, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C",currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="case">Gépház</label>
                    <select id="case" @bind="SelectedCaseId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(6, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C",currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="psu">Tápegység</label>
                    <select id="psu" @bind="SelectedPsuId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(7, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C",currencyformat))</option>
                        }
                    </select>
                </div>
                <div class="full"><label for="notes">Megjegyzés</label><textarea id="notes" @bind="NoteText" placeholder="Adja hozzá egyéb kérését vagy preferenciáját itt..."></textarea></div>
            </div>
            <div class="form-actions">
                @if (isEditing)
                {
                    <button class="btn btn-primary" @onclick="UpdateConfigurationAsync">Szerkesztés mentése</button>

                }
                else
                {
                    <button class="btn" @onclick="SaveConfigurationAsync">Konfiguráció mentése</button>
                }
            </div>
        </div>
        <div class="detail-card summary-box">
            <h3>Várható végösszeg</h3>
            <div class="summary-line"><span>CPU</span><strong>@(GetName(SelectedCpu)) <span class="price">@(SelectedCpu != null ? SelectedCpu.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>Alaplap</span><strong>@(GetName(SelectedMotherboard)) <span class="price">@(SelectedMotherboard != null ? SelectedMotherboard.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>GPU</span><strong>@(GetName(SelectedGpu)) <span class="price">@(SelectedGpu != null ? SelectedGpu.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>Memória</span><strong>@(GetName(SelectedRam)) <span class="price">@(SelectedRam != null ? SelectedRam.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>Tárkapacitás</span><strong>@(GetName(SelectedStorage)) <span class="price">@(SelectedStorage != null ? SelectedStorage.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>CPU hűtő</span><strong>@(GetName(SelectedCooler)) <span class="price">@(SelectedCooler != null ? SelectedCooler.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>Gépház</span><strong>@(GetName(SelectedCase)) <span class="price">@(SelectedCase != null ? SelectedCase.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>Tápegység</span><strong>@(GetName(SelectedPsu)) <span class="price">@(SelectedPsu != null ? SelectedPsu.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>Végösszeg</span><strong class="price">@TotalPrice.ToString("C", currencyformat)</strong></div>
            <p class="muted" style="margin-top:1rem;">A végösszeg változhat a jelenlegi piaci árakhoz igazítva...</p>
        </div>
    </section>
</main>

@code {
    private List<Components>? filteredComponents;
    private Dictionary<int, List<Components>> componentsByType = new();
    private System.Globalization.CultureInfo currencyformat = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private int? SelectedCpuId;
    private int? SelectedMotherboardId;
    private int? SelectedGpuId;
    private int? SelectedRamId;
    private int? SelectedStorageId;
    private int? SelectedCoolerId;
    private int? SelectedCaseId;
    private int? SelectedPsuId;
    private ComputerpartsLibrary.MODEL.Custom_builds? currentBuild = null;
    private bool isEditing = false;
    private string? NoteText;

    private Components? SelectedCpu => FindSelected(SelectedCpuId);
    private Components? SelectedMotherboard => FindSelected(SelectedMotherboardId);
    private Components? SelectedGpu => FindSelected(SelectedGpuId);
    private Components? SelectedRam => FindSelected(SelectedRamId);
    private Components? SelectedStorage => FindSelected(SelectedStorageId);
    private Components? SelectedCooler => FindSelected(SelectedCoolerId);
    private Components? SelectedCase => FindSelected(SelectedCaseId);
    private Components? SelectedPsu => FindSelected(SelectedPsuId);

    private decimal TotalPrice =>
        (SelectedCpu?.price ?? 0) + (SelectedMotherboard?.price ?? 0) + (SelectedGpu?.price ?? 0) + (SelectedRam?.price ?? 0) +
        (SelectedStorage?.price ?? 0) + (SelectedCooler?.price ?? 0) + (SelectedCase?.price ?? 0) +
        (SelectedPsu?.price ?? 0);

    private bool isLoading = false;
    private string? errorMessage;
    private bool showBackdrop = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<Components>>("api/components");
            if (all != null)
            {
                componentsByType = all.GroupBy(x => x.type_id).ToDictionary(g => g.Key, g => g.ToList());
            }
        }
        catch { }
        // try to load build from query if present on first init
        await LoadBuildFromQueryAsync();
        // subscribe to location changes so query updates trigger loading when navigating client-side
        Navigation.LocationChanged += OnLocationChanged;
    }

    private async Task UpdateConfigurationAsync()
    {
        if (currentBuild == null) return;

        // ensure user is authenticated
        if (AuthService == null || !AuthService.IsAuthenticated)
        {
            await JS.InvokeVoidAsync("alert", "Szerkesztés mentése csak bejelentkezett felhasználóknak lehetséges.");
            return;
        }

        // prepare updated build
        currentBuild.total_price = TotalPrice;
        // prepare components list same way as SaveConfigurationAsync
        var selected = new List<object>();
        if (SelectedCpu != null) selected.Add(new { type = "CPU", id = SelectedCpu.id, name = SelectedCpu.name, price = SelectedCpu.price });
        if (SelectedMotherboard != null) selected.Add(new { type = "MOTHERBOARD", id = SelectedMotherboard.id, name = SelectedMotherboard.name, price = SelectedMotherboard.price });
        if (SelectedGpu != null) selected.Add(new { type = "GPU", id = SelectedGpu.id, name = SelectedGpu.name, price = SelectedGpu.price });
        if (SelectedRam != null) selected.Add(new { type = "RAM", id = SelectedRam.id, name = SelectedRam.name, price = SelectedRam.price });
        if (SelectedStorage != null) selected.Add(new { type = "Storage", id = SelectedStorage.id, name = SelectedStorage.name, price = SelectedStorage.price });
        if (SelectedCooler != null) selected.Add(new { type = "Cooler", id = SelectedCooler.id, name = SelectedCooler.name, price = SelectedCooler.price });
        if (SelectedCase != null) selected.Add(new { type = "Case", id = SelectedCase.id, name = SelectedCase.name, price = SelectedCase.price });
        if (SelectedPsu != null) selected.Add(new { type = "PSU", id = SelectedPsu.id, name = SelectedPsu.name, price = SelectedPsu.price });

        if (!string.IsNullOrEmpty(NoteText))
        {
            selected.Add(new { type = "NOTE", id = (int?)null, name = (string?)null, price = (decimal?)null, note = NoteText });
        }

        currentBuild.components_json = System.Text.Json.JsonSerializer.Serialize(selected);

        try
        {
            // ensure token present
            if (string.IsNullOrEmpty(AuthService.Token)) await AuthService.InitializeAsync();

            // send PUT to update
            var req = new HttpRequestMessage(HttpMethod.Put, $"api/custombuilds/{currentBuild.build_id}")
            {
                Content = JsonContent.Create(currentBuild)
            };
            if (!string.IsNullOrEmpty(AuthService.Token)) req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", AuthService.Token);

            var resp = await Http.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Konfiguráció frissítve.");
            }
            else
            {
                var body = string.Empty;
                try { body = await resp.Content.ReadAsStringAsync(); } catch { }
                await JS.InvokeVoidAsync("alert", "Frissítés sikertelen: " + resp.StatusCode + " - " + body);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Hiba: " + ex.Message);
        }
        }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        // when navigated to with a query (client-side nav), this will run — attempt to load build
        await LoadBuildFromQueryAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // when location changes, attempt to load a build if a buildId query param exists
        try
        {
            await LoadBuildFromQueryAsync();
        }
        catch { }
    }

    private async Task LoadBuildFromQueryAsync()
    {
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var qs = QueryHelpers.ParseQuery(uri.Query);
            if (!qs.TryGetValue("buildId", out var bidValues)) return;
            if (!int.TryParse(bidValues.FirstOrDefault(), out var bid)) return;

            // ensure components are loaded
            if (componentsByType == null || componentsByType.Count == 0)
            {
                try
                {
                    var all = await Http.GetFromJsonAsync<List<Components>>("api/components");
                    if (all != null)
                    {
                        componentsByType = all.GroupBy(x => x.type_id).ToDictionary(g => g.Key, g => g.ToList());
                    }
                }
                catch { }
            }

            // fetch saved build
            var build = await Http.GetFromJsonAsync<ComputerpartsLibrary.MODEL.Custom_builds>($"api/custombuilds/{bid}");
            if (build == null) return;

            // keep reference to current opened build so we can update it later
            currentBuild = build;
            isEditing = true;

            if (string.IsNullOrEmpty(build.components_json)) return;

            try
            {
                var items = System.Text.Json.JsonSerializer.Deserialize<List<ComponentItem>>(build.components_json);
                if (items == null) return;

                // reset selections
                SelectedCpuId = null; SelectedMotherboardId = null; SelectedGpuId = null; SelectedRamId = null; SelectedStorageId = null; SelectedCoolerId = null; SelectedCaseId = null; SelectedPsuId = null;
                NoteText = null;

                foreach (var it in items)
                {
                    if (it == null) continue;
                    switch ((it.type ?? string.Empty).ToUpperInvariant())
                    {
                        case "CPU": SelectedCpuId = it.id; break;
                        case "GPU": SelectedGpuId = it.id; break;
                        case "RAM": SelectedRamId = it.id; break;
                        case "MOTHERBOARD": SelectedMotherboardId = it.id; break;
                        case "STORAGE": SelectedStorageId = it.id; break;
                        case "COOLER": SelectedCoolerId = it.id; break;
                        case "CASE": SelectedCaseId = it.id; break;
                        case "PSU": SelectedPsuId = it.id; break;
                        case "NOTE": NoteText = it.note; break;
                    }
                }

                StateHasChanged();
            }
        catch { isEditing = false; }
        }
        catch { }
    }

    private class ComponentItem
    {
        public string? type { get; set; }
        public int? id { get; set; }
        public string? name { get; set; }
        public decimal? price { get; set; }
        public string? note { get; set; }
    }

    private Components? FindSelected(int? id)
    {
        if (id == null) return null;
        foreach (var kv in componentsByType)
        {
            var found = kv.Value.FirstOrDefault(x => x.id == id.Value);
            if (found != null) return found;
        }
        return null;
    }

    private string GetName(Components? c) => c?.name ?? "-";

    private async Task SaveConfigurationAsync()
    {
        // only allow saving when authenticated
        if (AuthService == null || !AuthService.IsAuthenticated || AuthService.Token == null)
        {
            // show toast instead of alert
            await JS.InvokeVoidAsync("showToast", "Mentés csak bejelentkezett felhasználóknak lehetséges.", "warning", 5000);
            return;
        }

        var build = new ComputerpartsLibrary.MODEL.Custom_builds
        {
            User_id = AuthService?.UserId ?? 0,
            name = "Saved build",
            // set status required by DB constraint
            status = "draft",
            total_price = TotalPrice,
            created_at = DateTimeOffset.UtcNow
        };

        // prepare components list
        var selected = new List<object>();
        if (SelectedCpu != null) selected.Add(new { type = "CPU", id = SelectedCpu.id, name = SelectedCpu.name, price = SelectedCpu.price });
        if (SelectedGpu != null) selected.Add(new { type = "GPU", id = SelectedGpu.id, name = SelectedGpu.name, price = SelectedGpu.price });
        if (SelectedRam != null) selected.Add(new { type = "RAM", id = SelectedRam.id, name = SelectedRam.name, price = SelectedRam.price });
        if (SelectedMotherboard != null) selected.Add(new { type = "MOTHERBOARD", id = SelectedMotherboard.id, name = SelectedMotherboard.name, price = SelectedMotherboard.price });
        if (SelectedStorage != null) selected.Add(new { type = "Storage", id = SelectedStorage.id, name = SelectedStorage.name, price = SelectedStorage.price });
        if (SelectedCooler != null) selected.Add(new { type = "Cooler", id = SelectedCooler.id, name = SelectedCooler.name, price = SelectedCooler.price });
        if (SelectedCase != null) selected.Add(new { type = "Case", id = SelectedCase.id, name = SelectedCase.name, price = SelectedCase.price });
        if (SelectedPsu != null) selected.Add(new { type = "PSU", id = SelectedPsu.id, name = SelectedPsu.name, price = SelectedPsu.price });

        // include note as a separate item in the components JSON so the server doesn't need a dedicated column
        if (!string.IsNullOrEmpty(NoteText))
        {
            selected.Add(new { type = "NOTE", id = (int?)null, name = (string?)null, price = (decimal?)null, note = NoteText });
        }

        build.components_json = System.Text.Json.JsonSerializer.Serialize(selected);

        // log serialized payload for debugging to browser console
        await JS.InvokeVoidAsync("console.log", "Saving components_json: " + build.components_json);

        try
        {
            // ensure token is loaded
            if (!AuthService.IsAuthenticated || string.IsNullOrEmpty(AuthService.Token))
            {
                await AuthService.InitializeAsync();
            }

            var resp = await AuthService.PostAsJsonAsync("api/custombuilds", build);
            if (resp.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("showToast", "Konfiguráció elmentve.", "success", 4000);
            }
            else
            {
                var body = string.Empty;
                try { body = await resp.Content.ReadAsStringAsync(); } catch { }
                await JS.InvokeVoidAsync("console.log", $"Save config failed: {resp.StatusCode} {body}");
                if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized || resp.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    await JS.InvokeVoidAsync("showToast", "Nincs jogosultság a mentéshez. Kérlek jelentkezz be újra.", "warning", 6000);
                }
                else
                {
                    await JS.InvokeVoidAsync("showToast", "Hiba történt a mentés során: " + resp.StatusCode + " - " + body, "danger", 7000);
                }
            }
        }

        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", "Hiba: " + ex.Message);
        }
    }

    private async Task DeleteConfigurationAsync()
    {
        if (currentBuild == null) return;

        // only allow delete when authenticated and owner
        if (AuthService == null || !AuthService.IsAuthenticated || AuthService.UserId == null || AuthService.UserId != currentBuild.User_id)
        {
            await JS.InvokeVoidAsync("showToast", "Törlés csak a bejelentkezett tulajdonos számára lehetséges.", "warning", 5000);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", "Biztosan törölni szeretnéd ezt a konfigurációt?");
        if (!confirmed) return;

        try
        {
            // ensure token
            if (string.IsNullOrEmpty(AuthService.Token)) await AuthService.InitializeAsync();

            var req = new HttpRequestMessage(HttpMethod.Delete, $"api/custombuilds/{currentBuild.build_id}");
            if (!string.IsNullOrEmpty(AuthService.Token)) req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", AuthService.Token);

            var resp = await Http.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("showToast", "Konfiguráció törölve.", "success", 4000);
                // clear current state and navigate to configurator base page (remove query)
                currentBuild = null;
                isEditing = false;
                SelectedCpuId = null; SelectedMotherboardId = null; SelectedGpuId = null; SelectedRamId = null; SelectedStorageId = null; SelectedCoolerId = null; SelectedCaseId = null; SelectedPsuId = null;
                // navigate to same page without query
                var uri = new Uri(Navigation.Uri);
                var baseUri = uri.GetLeftPart(UriPartial.Path);
                Navigation.NavigateTo(baseUri, forceLoad: false);
            }
            else
            {
                var body = string.Empty;
                try { body = await resp.Content.ReadAsStringAsync(); } catch { }
                await JS.InvokeVoidAsync("showToast", "Törlés sikertelen: " + resp.StatusCode + " - " + body, "danger", 7000);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("showToast", "Hiba: " + ex.Message, "danger", 7000);
        }
    }
}
