@page "/configurator"
@using ComputerpartsFrontendBlazor.Components.Layout
@using ComputerpartsLibrary.MODEL
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inherits LayoutComponentBase
@rendermode InteractiveServer
<main style="min-height: 75vh;">
    <section class="page-header_custom page-header hero-mini">
        <h1>PC Konfigurátor</h1>
        <p>Rakjon össze egy kiegyensújozott PC-t, az elérhető fő komponensekből és a jobb oldali panelen ellenőrizve választásait.</p>
    </section>
    <section class="page-section configurator-layout">
        <div class="detail-card">
            <h3>Válaszd ki a megfelelő alkatrészeket</h3>
            <div class="form-grid">
                <div>
                    <label for="cpu">CPU</label>
                    <select id="cpu" @bind="SelectedCpuId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(1, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C", currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="gpu">GPU</label>
                    <select id="gpu" @bind="SelectedGpuId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(2, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C", currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="ram">Memória</label>
                    <select id="ram" @bind="SelectedRamId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(3, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C", currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="storage">Tárkapacitás</label>
                    <select id="storage" @bind="SelectedStorageId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(4, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C",currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="cooler">CPU hűtő</label>
                    <select id="cooler" @bind="SelectedCoolerId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(5, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C",currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="case">Gépház</label>
                    <select id="case" @bind="SelectedCaseId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(6, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C",currencyformat))</option>
                        }
                    </select>
                </div>
                <div>
                    <label for="psu">Tápegység</label>
                    <select id="psu" @bind="SelectedPsuId">
                        <option value="">--Válassz alkatrészt--</option>
                        @foreach (var component in componentsByType.GetValueOrDefault(7, new List<Components>()))
                        {
                            <option value="@component.id">@component.name (@component.price.ToString("C",currencyformat))</option>
                        }
                    </select>
                </div>
                <div class="full"><label for="notes">Megjegyzés</label><textarea id="notes" placeholder="Adja hozzá egyéb kérését vagy preferenciáját itt..."></textarea></div>
            </div>
            <div class="form-actions"><button class="btn" data-demo="Demo mode: configuration saved.">Konfiguráció mentése</button></div>
        </div>
        <div class="detail-card summary-box">
            <h3>Várható végösszeg</h3>
            <div class="summary-line"><span>CPU</span><strong>@(GetName(SelectedCpu)) <span class="price">@(SelectedCpu != null ? SelectedCpu.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>GPU</span><strong>@(GetName(SelectedGpu)) <span class="price">@(SelectedGpu != null ? SelectedGpu.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>Memória</span><strong>@(GetName(SelectedRam)) <span class="price">@(SelectedRam != null ? SelectedRam.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>Tárkapacitás</span><strong>@(GetName(SelectedStorage)) <span class="price">@(SelectedStorage != null ? SelectedStorage.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>CPU hűtő</span><strong>@(GetName(SelectedCooler)) <span class="price">@(SelectedCooler != null ? SelectedCooler.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>Gépház</span><strong>@(GetName(SelectedCase)) <span class="price">@(SelectedCase != null ? SelectedCase.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>Tápegység</span><strong>@(GetName(SelectedPsu)) <span class="price">@(SelectedPsu != null ? SelectedPsu.price.ToString("C", currencyformat) : "")</span></strong></div>
            <div class="summary-line"><span>Végösszeg</span><strong class="price">@TotalPrice.ToString("C", currencyformat)</strong></div>
            <p class="muted" style="margin-top:1rem;">A végösszeg változhat a jelenlegi piaci árakhoz igazítva...</p>
        </div>
    </section>
</main>

@code {
    private List<Components>? filteredComponents;
    private Dictionary<int, List<Components>> componentsByType = new();
    private System.Globalization.CultureInfo currencyformat = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private int? SelectedCpuId;
    private int? SelectedGpuId;
    private int? SelectedRamId;
    private int? SelectedStorageId;
    private int? SelectedCoolerId;
    private int? SelectedCaseId;
    private int? SelectedPsuId;

    private Components? SelectedCpu => FindSelected(SelectedCpuId);
    private Components? SelectedGpu => FindSelected(SelectedGpuId);
    private Components? SelectedRam => FindSelected(SelectedRamId);
    private Components? SelectedStorage => FindSelected(SelectedStorageId);
    private Components? SelectedCooler => FindSelected(SelectedCoolerId);
    private Components? SelectedCase => FindSelected(SelectedCaseId);
    private Components? SelectedPsu => FindSelected(SelectedPsuId);

    private decimal TotalPrice =>
        (SelectedCpu?.price ?? 0) + (SelectedGpu?.price ?? 0) + (SelectedRam?.price ?? 0) +
        (SelectedStorage?.price ?? 0) + (SelectedCooler?.price ?? 0) + (SelectedCase?.price ?? 0) +
        (SelectedPsu?.price ?? 0);

    private bool isLoading = false;
    private string? errorMessage;
    private bool showBackdrop = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<Components>>("api/components");
            if (all != null)
            {
                componentsByType = all.GroupBy(x => x.type_id).ToDictionary(g => g.Key, g => g.ToList());
            }
        }
        catch { }
    }

    private Components? FindSelected(int? id)
    {
        if (id == null) return null;
        foreach (var kv in componentsByType)
        {
            var found = kv.Value.FirstOrDefault(x => x.id == id.Value);
            if (found != null) return found;
        }
        return null;
    }

    private string GetName(Components? c) => c?.name ?? "-";
}
