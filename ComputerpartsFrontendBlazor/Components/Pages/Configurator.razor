@page "/configurator"
@using ComputerpartsFrontendBlazor.Components.Layout
@inherits LayoutComponentBase
@rendermode InteractiveServer
<main style="min-height: 75vh;">
    <section class="page-header_custom page-header hero-mini">
        <h1>PC Konfigurátor</h1>
        <p>Rakjon össze egy kiegyensújozott PC-t, az elérhető fő komponensekből és a jobb oldali panelen ellenőrizve választásait.</p>
    </section>
    <section class="page-section configurator-layout">
        <div class="detail-card">
            <h3>Válaszd ki a megfelelő alkatrészeket</h3>
            <div class="form-grid">
                <div><label for="cpu">CPU</label><select id="cpu"><option>--Válassz alkatrészt--</option><option>Intel Core i7-13700K</option><option>AMD Ryzen 7 7800X3D</option><option>Intel Core i5-14600K</option></select></div>
                <div><label for="gpu">GPU</label><select id="gpu"><option>--Válassz alkatrészt--</option><option>NVIDIA RTX 4080</option><option>AMD Radeon RX 7900 XT</option><option>NVIDIA RTX 4070 Super</option></select></div>
                <div><label for="ram">Memória</label><select id="ram"><option>--Válassz alkatrészt--</option><option>32 GB DDR5 6000</option><option>64 GB DDR5 5600</option><option>16 GB DDR5 5200</option></select></div>
                <div><label for="storage">Tárkapacitás</label><select id="storage"><option>--Válassz alkatrészt--</option><option>Samsung 980 Pro 2TB</option><option>WD Black SN850X 1TB</option><option>Kingston NV2 2TB</option></select></div>
                <div><label for="cooler">CPU hűtő</label><select id="cooler"><option>--Válassz alkatrészt--</option><option>360 mm AIO</option><option>Dual-tower air cooler</option><option>240 mm AIO</option></select></div>
                <div><label for="psu">Tápegység</label><select id="psu"><option>--Válassz alkatrészt--</option><option>850W 80+ Gold</option><option>1000W 80+ Gold</option><option>750W 80+ Bronze</option></select></div>
                <div class="full"><label for="notes">Megjegyzés</label><textarea id="notes" placeholder="Adja hozzá egyéb kérését vagy preferenciáját itt..."></textarea></div>
            </div>
            <div class="form-actions"><button class="btn" data-demo="Demo mode: configuration saved.">Konfiguráció mentése</button>@* <button class="btn-secondary" data-demo="Demo mode: compatibility check finished.">Check Compatibility</button> *@</div>
        </div>
        <div class="detail-card summary-box">
            <h3>Várható végösszeg</h3>
            <div class="summary-line"><span>CPU</span><strong>Intel Core i7-13700K</strong></div>
            <div class="summary-line"><span>GPU</span><strong>NVIDIA RTX 4080</strong></div>
            <div class="summary-line"><span>Memória</span><strong>32 GB DDR5</strong></div>
            <div class="summary-line"><span>Tárkapacitás</span><strong>2 TB NVMe SSD</strong></div>
            <div class="summary-line"><span>Tápegység</span><strong>850W Gold</strong></div>
            <div class="summary-line"><span>Végösszeg</span><strong class="price">$2,798.99</strong></div>
            <p class="muted" style="margin-top:1rem;">A végösszeg változhat a jelenlegi piaci árakhoz igazítva...</p>
        </div>
    </section>
</main>

