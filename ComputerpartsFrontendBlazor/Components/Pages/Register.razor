@page "/register"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<main class="auth-wrap">
    <section class="login-card page-anim">
        <h2>Regisztráció</h2>
        <p class="muted" style="margin-bottom:1rem;">Készíts új vevői fiókot a rendelésekhez, mentett konfigurációkhoz és segítségkérések követéséhez.</p>

        <div class="form-grid">
            <div>
                <label for="regFirst">Keresztnév</label>
                <input id="regFirst" @bind="Model.FirstName" type="text" placeholder="Keresztnév" />
            </div>
            <div>
                <label for="regLast">Családnév</label>
                <input id="regLast" @bind="Model.LastName" type="text" placeholder="Családnév" />
            </div>
            <div class="full">
                <label for="regEmail">Email</label>
                <input id="regEmail" @bind="Model.Email" type="email" placeholder="you@example.com" />
            </div>
            <div>
                <label for="regPassword">Jelszó</label>
                <input id="regPassword" @bind="Model.Password" type="password" placeholder="Jelszó" />
            </div>
            <div>
                <label for="regPassword2">Jelszó megerősítése</label>
                <input id="regPassword2" @bind="Model.ConfirmPassword" type="password" placeholder="Leszó megerősítése" />
            </div>
        </div>

        <div class="form-actions">
            <button class="btn" style="width: 100%" @onclick="RegisterAsync" disabled="@(IsSubmitting)">
                @(IsSubmitting ? "Creating..." : "Create Account")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <p class="muted">@StatusMessage</p>
        }

        <p class="switch-link">Van már fiókod? <a href="login">Térj vissza a bejelentkezéshez.</a>.</p>
        <p class="switch-link">Vissza a kezőlapra <a href="/">Kezdőlap</a></p>
    </section>
</main>


@code {
    private RegisterFormModel Model { get; set; } = new();
    private bool IsSubmitting { get; set; }
    private string? StatusMessage { get; set; }

    private class RegisterFormModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private async Task RegisterAsync()
    {
        StatusMessage = null;

        // Alapvető, kliens oldali validáció a gyakori hibák elkerüléséhez
        if (string.IsNullOrWhiteSpace(Model.FirstName) || string.IsNullOrWhiteSpace(Model.LastName))
        {
            StatusMessage = "Kérlek, add meg a kereszt- és vezetékneved!";
            return;
        }

        if (string.IsNullOrWhiteSpace(Model.Email))
        {
            StatusMessage = "Kérlek, adj meg egy email címet!";
            return;
        }

        if (string.IsNullOrEmpty(Model.Password) || Model.Password.Length < 8)
        {
            StatusMessage = "A jelszónak minimum nyolc (8) karakter hosszúnak kell lennie!";
            return;
        }

        if (Model.Password != Model.ConfirmPassword)
        {
            StatusMessage = "A jelszavak nem egyeznek!";
            return;
        }

        IsSubmitting = true;

        try
        {
            // Felhasználónév kinyerése kerszt- és vezetéknévből, szóközök eltávolítása és kisbetűsítés (tartalék az email local-partje)
            var username = (Model.FirstName + Model.LastName).Replace(" ", "").ToLowerInvariant();
            if (string.IsNullOrWhiteSpace(username))
            {
                var at = Model.Email.IndexOf('@');
                username = at > 0 ? Model.Email.Substring(0, at) : Model.Email;
            }

            var payload = new
            {
                Username = username,
                Email = Model.Email,
                Password = Model.Password
            };

            var response = await Http.PostAsJsonAsync("api/auth/register", payload);

            if (response.IsSuccessStatusCode)
            {
                // Sikeres regisztráció - átirányítás a bejelentkező oldalra
                StatusMessage = "Sikeres regisztráció. Átirányítás a bejelentkező oldalra...";
                // small delay to let user read message
                await Task.Delay(800);
                Navigation.NavigateTo("/login");
            }
            else
            {
                // Hibaüzenet kivonása a válaszból, ha elérhető
                try
                {
                    var errorObj = await response.Content.ReadFromJsonAsync<ServerError?>();
                    StatusMessage = errorObj?.message ?? "Sikertelen regisztráció. Kérjük, próbáld úja!";
                }
                catch
                {
                    StatusMessage = "Sikertelen regisztráció. Kérjük, próbáld úja!";
                }
            }
        }
        catch (Exception ex)
        {
            StatusMessage = "An error occurred: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private class ServerError
    {
        public string? message { get; set; }
    }
}
