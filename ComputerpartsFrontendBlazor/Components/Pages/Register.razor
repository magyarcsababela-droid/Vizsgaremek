@page "/register"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<main class="auth-wrap">
    <section class="login-card page-anim">
        <h2>Regisztráció</h2>
        <p class="muted" style="margin-bottom:1rem;">Készíts új vevői fiókot a rendelésekhez, mentett konfigurációkhoz és segítségkérések követéséhez.</p>

        <div class="form-grid">
            <div class="full">
                <label for="regUsername">Felhasználónév</label>
                <input id="regUsername" @bind="Model.Username" type="text" placeholder="Felhasználónév" />
            </div>
            <div class="full">
                <label for="regEmail">Email</label>
                <input id="regEmail" @bind="Model.Email" type="email" placeholder="you@example.com" />
            </div>
            <div>
                <label for="regPassword">Jelszó</label>
                <input id="regPassword" @bind="Model.Password" type="password" placeholder="Jelszó" />
            </div>
            <div>
                <label for="regPassword2">Jelszó megerősítése</label>
                <input id="regPassword2" @bind="Model.ConfirmPassword" type="password" placeholder="Jelszó megerősítése" />
            </div>
        </div>

        <div class="form-actions">
            <button class="btn" style="width: 100%" @onclick="RegisterAsync" disabled="@(IsSubmitting)">
                @(IsSubmitting ? "Regisztrálás..." : "Regisztrálás")
            </button>
        </div>



        <p class="switch-link">Van már fiókod? <a href="login">Térj vissza a bejelentkezéshez.</a>.</p>
        <p class="switch-link">Vissza a kezőlapra <a href="/">Kezdőlap</a></p>
    </section>
</main>

@if (!string.IsNullOrEmpty(StatusMessage))
{
    <Toast Message="@StatusMessage" Type="warning" Position="bottom-center" AutoHide="true" Duration="5000" />
}


@code {
    private RegisterFormModel Model { get; set; } = new();
    private bool IsSubmitting { get; set; }
    private string? StatusMessage { get; set; }

    private class RegisterFormModel
    {
        public string Username { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private async Task RegisterAsync()
    {
        StatusMessage = null;

        // Alapvető, kliens oldali validáció a gyakori hibák elkerüléséhez
        if (string.IsNullOrWhiteSpace(Model.Username))
        {
            StatusMessage = "Kérlek adj meg egy felhasználónevet.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Model.Email))
        {
            StatusMessage = "Kérlek add meg az Email címed.";
            return;
        }

        if (string.IsNullOrEmpty(Model.Password) || Model.Password.Length < 8)
        {
            StatusMessage = "A jelszónak legalább 8 karakter hosszúnak kell lennie.";
            return;
        }

        if (Model.Password != Model.ConfirmPassword)
        {
            StatusMessage = "A jelszavak nem egyeznek.";
            return;
        }

        IsSubmitting = true;

        try
        {
            // Derive a username from first and last name (fallback to email local-part)
            var username = (Model.Username).Replace(" ", "").ToLowerInvariant();
            if (string.IsNullOrWhiteSpace(username))
            {
                var at = Model.Email.IndexOf('@');
                username = at > 0 ? Model.Email.Substring(0, at) : Model.Email;
            }

            var payload = new
            {
                Username = Model.Username,
                Email = Model.Email,
                Password = Model.Password
            };

            var response = await Http.PostAsJsonAsync("api/auth/register", payload);

            if (response.IsSuccessStatusCode)
            {
                StatusMessage = "Regisztrálás sikeres. Most jelentkezz be.";
                await Task.Delay(800);
                Navigation.NavigateTo("/login");
            }
            else
            {
                // Hibaüzenet kivonása a válaszból, ha elérhető
                try
                {
                    var errorObj = await response.Content.ReadFromJsonAsync<ServerError?>();
                    StatusMessage = errorObj?.message ?? "Regisztráció sikertelen. Kérlek próbáld újra.";
                }
                catch
                {
                    StatusMessage = "Regisztráció sikertelen. Kérlek próbáld újra.";
                }
            }
        }
        catch (Exception ex)
        {
            StatusMessage = "Hiba történt: " + ex.Message;
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private class ServerError
    {
        public string? message { get; set; }
    }
}
