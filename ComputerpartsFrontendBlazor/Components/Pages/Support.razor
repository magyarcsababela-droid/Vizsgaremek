@page "/support"
@using System.ComponentModel.DataAnnotations
@rendermode InteractiveServer
@inherits LayoutComponentBase

<main>
    <section class="page-header_custom page-header hero-mini">
        <h1>Támogatás</h1>
        <p>Gyakran ismételt kérdések, terméktámogatás és ügyfélszolgálati űrlap.</p>
    </section>

    <section class="page-section">
        <h2>Gyakori kérdések</h2>
        <div class="faq-list">
            <div class="faq-item"><h3>Hogyan követhetem a rendelésemet?</h3><p class="muted">Belépés után a fiók &gt; Rendelések menüpont alatt találod.</p></div>
            <div class="faq-item"><h3>Mit tegyek ha hibás terméket kaptam?</h3><p class="muted">Kérjük vedd fel velünk a kapcsolatot a Kapcsolat oldalon vagy írj az <em>support@example.com</em> címre. A hibás termékekre visszaküldési és csere folyamatunk 14 napon belül érvényes.</p></div>
            <div class="faq-item"><h3>Mikor kapom meg a jótállást?</h3><p class="muted">A jótállási idő a gyártótól függ; általában 1-3 év. Kérjük csatold a rendelés számát a támogatási kérelemhez.</p></div>
        </div>
    </section>

    <section class="page-section">
        <h2>Ügyfélszolgálati jegy küldése</h2>
        <EditForm Model="Ticket" OnValidSubmit="SubmitTicket">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="form-grid">
                <div>
                    <label for="name">Név</label>
                    <InputText id="name" @bind-Value="Ticket.Name" />
                </div>
                <div>
                    <label for="email">Email</label>
                    <InputText id="email" @bind-Value="Ticket.Email" />
                </div>
                <div>
                    <label for="order">Rendelés száma (opcionális)</label>
                    <InputText id="order" @bind-Value="Ticket.OrderNumber" />
                </div>
                <div>
                    <label for="category">Kategória</label>
                    <InputSelect id="category" @bind-Value="Ticket.Category">
                        <option value="General">Általános</option>
                        <option value="Order">Rendelés</option>
                        <option value="Returns">Visszaküldés</option>
                        <option value="Warranty">Jótállás</option>
                    </InputSelect>
                </div>
                <div class="full">
                    <label for="message">Leírás</label>
                    <InputTextArea id="message" @bind-Value="Ticket.Message" />
                </div>
            </div>

            <div class="form-actions">
                <button class="btn" type="submit">Jegy küldése</button>
            </div>
        </EditForm>

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <p class="muted">@SuccessMessage</p>
        }
    </section>
</main>

@code {
    private SupportTicket Ticket { get; set; } = new();
    private string? SuccessMessage { get; set; }

    private async Task SubmitTicket()
    {
        // Demo behaviour: pretend to send ticket to API
        await Task.Delay(500);
        SuccessMessage = "Köszönjük! A jegyedet fogadtuk, a munkatársaink hamarosan felveszik veled a kapcsolatot.";
        Ticket = new SupportTicket();
    }

    private class SupportTicket
    {
        [Required]
        public string Name { get; set; } = string.Empty;

        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        public string? OrderNumber { get; set; }

        [Required]
        public string Category { get; set; } = "General";

        [Required]
        public string Message { get; set; } = string.Empty;
    }
}
